# Local release tooling and notes
/publish-github.sh
/push-source.sh
/publish.conf
/release-mirror.conf
/GITHUB-RELEASE-GUIDE.md
/.publish-allow
/Github repository

# Convention output folders (root-anchored)
/JellyDualPlay Dist/
/JellyDualPlay Git/
/JellyDualPlay App/

# Local editor and tooling state (any dot folder except .github)
.*/
!.github/

# Archives and transient files
*.zip
*.7z
*.log
*.tmp

# Python bytecode (Kodi generates these next to the addon source)
__pycache__/
*.pyc

# No secret files in this project: the follower's username/password are typed
# into Kodi's addon settings and stored in Kodi userdata, never in the repo.
# If that ever changes, list the secret file here explicitly by path.

# Added 12/09/2026 (Linux packaging sweep)
# Internal ops docs and local only leftovers, never published
/Packaging.md
/PROJECT_NOTES.md
/.review/
/build.conf
/deploy_to_programfiles.ps1
/deploy_log.txt
@eaDir/
Thumbs.db
.DS_Store
desktop.ini

# Secrets, both cases because matching is case sensitive. Nothing secret
# lives in this tree; the patterns stop one being added by accident.
.env
.env.*
*credential*
*CREDENTIAL*
*Credential*
*password*
*PASSWORD*
*Password*
*secret*
*SECRET*
*Secret*
*token*
*TOKEN*
*Token*
*cred*
*CRED*
*sftp*
*SFTP*
*ftp*
*FTP*
*.pem
*.key
*.pfx
id_rsa*
connection.txt
*config.local*
*.bak

# Dev only files inside the add-on folder, dropped from both zips by build-zip.sh
/service.jellyfin.dualplay/**/*_test.py
/service.jellyfin.dualplay/**/test_*.py
# (test.py is the settings dialog check script and ships, so it is not listed)
